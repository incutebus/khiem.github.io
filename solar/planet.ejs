<%- include('partials/header.ejs') %>

<section class="panel">
  <h2>Planet <%= planetName %></h2>

  <div class="row g-4 align-items-start">
    <div class="col-md-5">
      <img class="planet-img" src="<%= planetInfo.image %>" alt="<%= planetName %>">
    </div>

    <div class="col-md-7">
      <p><%= planetInfo.description %></p>

      <table class="table table-dark table-striped">
        <tbody>
          <tr><th>Number of Moons</th>      <td><%= planetInfo.moons %></td></tr>
          <tr><th>Radius</th>               <td><%= planetInfo.radius.toLocaleString() %> miles</td></tr>
          <tr><th>Distance from the Sun</th><td><%= planetInfo.distanceFromSun %></td></tr>
          <tr><th>Length of Year</th>       <td><%= planetInfo.yearLength %></td></tr>
          <tr><th>Length of One Day</th>    <td><%= planetInfo.oneEarthDay %></td></tr>
          <tr><th>More Info</th>            <td><a href="<%= planetInfo.websiteLink %>" target="_blank"><%= planetInfo.websiteLink %></a></td></tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

<%- include('partials/footer.ejs') %>
